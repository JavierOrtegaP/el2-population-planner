<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the planner (pure C#, no game types) against hand-built game states. Run: dotnet run, project tests/PlannerTests.csproj -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>PopulationPlanner.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <!-- Runs on any newer .NET too. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\src\GameState.cs" />
    <Compile Include="..\src\GameSettings.cs" />
    <Compile Include="..\src\Planner.cs" />
    <Compile Include="..\src\JobOptimizer.cs" />
  </ItemGroup>

</Project>
